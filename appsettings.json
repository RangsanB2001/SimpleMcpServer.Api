{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "McpServer": {
    "Name": "SimpleMcpServer",
    "Version": "1.0.0",
    "EnableWebSocket": true,
    "EnableStdio": true
  },
  "Auth": {
    "ApiKey": "super-secret-key"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  }
}
