@SimpleMcpServer.Api_HostAddress = http://localhost:5063

# Endpoint: POST {HostAddress}/mcp
# Headers required by Streamable HTTP MCP transport:
#   Accept: application/json, text/event-stream
#   Content-Type: application/json

### List tools
POST {{SimpleMcpServer.Api_HostAddress}}/mcp
Accept: application/json, text/event-stream
Content-Type: application/json

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "tools/list"
}

### fundamental_lookup — latest quarter for PTT
POST {{SimpleMcpServer.Api_HostAddress}}/mcp
Accept: application/json, text/event-stream
Content-Type: application/json

{
  "jsonrpc": "2.0",
  "id": 2,
  "method": "tools/call",
  "params": {
    "name": "fundamental_lookup",
    "arguments": { "symbol": "PTT" }
  }
}

### fundamental_lookup — PTT FY2024 Q3
POST {{SimpleMcpServer.Api_HostAddress}}/mcp
Accept: application/json, text/event-stream
Content-Type: application/json

{
  "jsonrpc": "2.0",
  "id": 3,
  "method": "tools/call",
  "params": {
    "name": "fundamental_lookup",
    "arguments": { "symbol": "PTT", "fiscal": 2024, "quarter": "3" }
  }
}

### daily_prices — latest day for PTT
POST {{SimpleMcpServer.Api_HostAddress}}/mcp
Accept: application/json, text/event-stream
Content-Type: application/json

{
  "jsonrpc": "2.0",
  "id": 4,
  "method": "tools/call",
  "params": {
    "name": "daily_prices",
    "arguments": { "symbol": "PTT" }
  }
}

### daily_prices — PTT date range
POST {{SimpleMcpServer.Api_HostAddress}}/mcp
Accept: application/json, text/event-stream
Content-Type: application/json

{
  "jsonrpc": "2.0",
  "id": 5,
  "method": "tools/call",
  "params": {
    "name": "daily_prices",
    "arguments": { "symbol": "PTT", "fromDate": "2024-01-01", "toDate": "2024-01-31" }
  }
}

### dividends — recent dividends for PTT
POST {{SimpleMcpServer.Api_HostAddress}}/mcp
Accept: application/json, text/event-stream
Content-Type: application/json

{
  "jsonrpc": "2.0",
  "id": 6,
  "method": "tools/call",
  "params": {
    "name": "dividends",
    "arguments": { "symbol": "PTT", "limit": 5 }
  }
}

